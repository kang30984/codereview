# ── Slack 알림 ────────────────────────────────────────────────
# Slack Incoming Webhook URL (미설정 시 알림 전송을 건너뜁니다)
SLACK_WEBHOOK_URL=

# ── Ollama 설정 ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ── 분석 대상 ────────────────────────────────────────────────
TARGET_DIR=./target_dir

# main 디렉터리 필터 모드 (미설정 시 auto)
#   auto : 대상 폴더를 스캔해 구조를 자동 판별합니다. (권장)
#          - main 하위에 소스가 있으면  -> 표준 구조로 보고 src/main/** 만 분석
#          - main 디렉터리가 없으면     -> 레거시 구조로 보고 전체 소스 분석
#   1    : 항상 경로에 'main' 이 포함된 파일만 분석 (표준 구조 강제)
#   0    : 항상 전체 소스 분석 (레거시 구조 강제)
REQUIRE_MAIN_PATH=auto

# 레거시 구조에서 테스트 코드(test/, tests/, testcase/)를 제외할지 여부. 0 이면 포함합니다.
EXCLUDE_TEST_PATHS=1

# 1로 설정하면 audit_report.json 을 TARGET_DIR 안에도 복사합니다.
# 리포트에는 취약점 위치와 코드 조각이 포함되므로 기본값은 0(복사 안 함)입니다.
COPY_REPORT_TO_TARGET=0

# ── (선택) 사내 프록시/자체 서명 인증서 환경에서만 1로 설정 ──
# 경고: TLS 인증서 검증을 비활성화합니다. 신뢰된 내부망에서만 사용하세요.
ALLOW_INSECURE_TLS=0
